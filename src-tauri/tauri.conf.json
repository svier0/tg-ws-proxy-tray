{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tg-ws-proxy-tray",
  "version": "0.1.0",
  "identifier": "com.github.svier0.tg-ws-proxy-tray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../target/server/": "server/"
    }
  }
}
